{
  "name": "pageberth",
  "private": true,
  "version": "0.1.0-alpha.15",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && vite build --base ./ && electron .",
    "electron:build": "npm run icons && tsc -p tsconfig.electron.json && vite build --base ./ && electron-builder --publish never",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "dompurify": "^3.1.0",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "main": "electron/main.js",
  "author": {
    "name": "skpcd"
  },
  "build": {
    "appId": "app.inkwell",
    "productName": "Pageberth",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.js",
      "electron/preload.cjs",
      "electron/index.html"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pageberth",
      "artifactName": "Pageberth Setup ${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "skpcd",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {}
}
